# Copy this file to .env.local for local reference (gitignored).
# These values must ALSO be set in Vercel: Project Settings > Environment Variables
# (Production, Preview, and Development scopes).
#
# Local Vite dev (`npm run dev`) does not run the api/* serverless functions, so
# .env.local is informational here — Vercel reads from its own env-var store
# at runtime in production.

INDEXNOW_KEY=a2c11531e7de47a08dfe4cb47d120610
INDEXNOW_KEY_LOCATION=https://foundforai.com/a2c11531e7de47a08dfe4cb47d120610.txt
INDEXNOW_HOST=foundforai.com

# Generate fresh: `openssl rand -hex 16`. Used to authenticate the manual
# /api/indexnow/manual endpoint and also accepted by the cron endpoint.
ADMIN_API_KEY=replace_with_32_char_hex_string

# OpenAI (ChatGPT Ads) Conversions API key. From Ads Manager > your pixel >
# Conversions API tab. Powers server-side order_created reporting in
# api/_openai.ts. If unset, server-side reporting no-ops (the browser pixel
# still fires). Must be set in Vercel Production for live conversions.
OPENAI_ADS_API_KEY=replace_with_openai_conversions_api_key

# Community program. Do not commit real values.
# Leave DATABASE_URL unset until you provision Postgres and run
# db/community/001_init.sql. Local dev uses .data/community.json.
# DATABASE_URL=
# COMMUNITY_DATA_FILE=.data/community.json
# Confirmation email stays off. Do not set this to true until a provider
# is chosen. The send function still refuses to deliver without a provider.
# COMMUNITY_EMAIL_ENABLED=false
# Optional. Neither site uses Turnstile today. If you add it, set the secret
# here and the site key in the form. Unset means the check is skipped.
# TURNSTILE_SECRET_KEY=
